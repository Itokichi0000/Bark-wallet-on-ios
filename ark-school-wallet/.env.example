# Ark School Wallet is Signet-only. These are Second's public Signet endpoints
# (https://second.tech/docs/connection-details). The build refuses mainnet hosts
# and any VITE_BARK_NETWORK other than "signet".
VITE_BARK_NETWORK=signet
VITE_ARK_SERVER_URL=https://ark.signet.2nd.dev
VITE_ESPLORA_URL=https://esplora.signet.2nd.dev
# Signet faucet (needs a GitHub login): https://signet.2nd.dev/
